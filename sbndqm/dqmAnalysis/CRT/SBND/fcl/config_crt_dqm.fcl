#include "crt_channel_list.fcl"

BEGIN_PROLOG 

streamCRT: {
  
  module_type: BernCRTdqmSBND

  Debug:                        true
  CRTModuleLabel:               "daq"
  CRTInstanceLabel:             "ContainerBERNCRTV2"
  SPECTDCModuleLabel:           "daq"
  SPECTDCInstanceLabels:        [ "TDCTIMESTAMP", "ContainerTDCTIMESTAMP" ]
  DAQHeaderModuleLabel:         "daq"
  DAQHeaderInstanceLabel:       "RawEventHeader"
  SPECTDCT1Channel:             0
  RawTSCorrection:              367000
  BigHitADCThreshold:           600
  BoardsRequiredForResetSpread: 100
  RateNormalisation:            0.05

  metric_board_config: {
    groups: {
    CRT_board: [
	88, 152, 156, 153, 159, 134, 135, 238, 155, 151, 150, 136, 157, 158, 182, 149, 73, 58, # North
	60, 56, 169, 166, 24, 57, 33, 34, 61, 171, 59, 176, 170, 168, 172, 173, # South
	160, 222, 220, 81, 85, 143, 162, 133, 132, 44, 147, 146, 131, 79, 206, 204, 200, 18, # East
	174, 148, 163, 164, 165, 55, 120, 42, 138, 130, 197, 199, 202, 19, 198, 45, 203, 207, # West
	82, 86, 90, 91, 99, 100, 93, 94, 95, 87, 97, 98, 77, 78, 83, 84, 104, 103, 102, 101, # Bottom
	111, 107, 106, 115, 105, 123, 50, 125, 126, 129, 114, 118, 48, 145, 119, 223, 36, 51, 71, 187, 16, 205, 35, 228, 75, # TopLow
	121, 40, 39, 128, 127, 178, 144, 180, 141, 179, 109, 116, 47, 49, 117, 185, 184, 183, 72, 216, 213, 212, 211, 210, 209  # TopHigh
      ]
    }
    streams:[slow, fast, archiving]
    metrics:{
      TS0: {
	units: ns
	title: "CRT board %(instance)s Ts0 (ns)"
	#display_range: []
      }
      TS1: {
	units: ns
	title: "CRT board %(instance)s Ts1 (ns)"
	#display_range: []
      }
      T0clockdrift: {
	units: ns
	title: "CRT board %(instance)s Ts0 clockdrift (ns)"
	display_range: [-20.0, 20.0]
      }
      T1ResetTDCDiff: {
	units: ns
	title: "CRT board %(instance)s difference between (T1-reset's Ts0) and (TDC value) (ns)"
	display_range: [0.0, 100.0]
      }
      MaxADCValue: {
	units: ADC
	title: "CRT board %(instance)s max ADC value (ADC)"
	display_range: [0.0, 4000.0]
      }
      MaxADCChannel: {
	title: "CRT board %(instance)s max ADC channel (channel index)"
	display_range: [0.0, 31.0]
      }
      MaxADCValuePair: {
	units: ADC
	title: "CRT board %(instance)s ADC value of max-paired channel (ADC)"
	display_range: [0.0, 4000.0]
      }
      MaxADCChannelPair: {
	title: "CRT board %(instance)s index of max-paired channel (channel index)"
	display_range: [0.0, 31.0]
      }
      Flag: {
	title: "CRT board %(instance)s flag type"
	display_range: [0.0, 15.0]
      }
      baseline: {
	units: ADC
	title: "CRT board %(instance)s baseline (ADC)"
	display_range: [0.0, 4000.0]
      } 
      AverageADC: { 
	units: ADC
	title: "CRT board %(instance)s average ADC across all channels (ADC)"
	display_range: [0.0, 4000.0] 
      }    
      Flag3Hit: {
	title: "CRT board %(instance)s average N flag 3 hits"
      }
      Deadtime: {
	units: ns
	title: "CRT board %(instance)s minimum deadtime (ns)"
	#display_range: [0.0, 1000000.0]
      }
      ReadoutRate: {
	title: "CRT board %(instance)s average normalised readout rate"
      }
      PullWindow: {
	units: ns
	title: "CRT board %(instance)s pull window (ns)"
      }
      earlysynch: { 
	units: ns
	title: "CRT board %(instance)s fragment average distance from last poll start (ns)"
	display_range: [-100000,100000] 
	alarmrange: [-100000,100000] 
      }
      latesynch: { 
	units: ns
	title: "CRT board %(instance)s fragment average distance from this poll end (ns)"
	display_range: [-100000,100000]
	alarmrange: [-100000,100000] 
      }
      MissingT0: {
	title: "CRT board %(instance)s missed T0 resets"
      }
      MissingT1: {
	title: "CRT board %(instance)s missed T1 resets"
      }
      NT0Resets: {
	title: "CRT board %(instance)s maximum N T0 resets"
      }
      NT1Resets: {
	title: "CRT board %(instance)s maximum N T1 resets"
      }
    }
  }
  
  metric_channel_config: 
  {
    groups: { CRT_channel: @local::crt_channel_list }
    streams: [slow, fast, archiving]
    metrics:{ 
      ADC:{ 
	units: ADC
	title: "CRT channel %(instance)s average ADC"
	display_range: [0, 4000] 
      }
      lastbighit: {
	units: ns
	title: "CRT channel %(instance)s timestamp at last hit with > 600 ADC (ns)"
	display_range: [0.0, 1000000000.0]
      }
      ChReadoutRate: {
	title: "CRT channel %(instance)s average normalised readout rate"
      }
      Pedestal: {
	units: ADC
	title: "CRT channel %(instance)s pedestal (ADC)"
	display_range: [0.0, 4000.0]
      }
    }       
  }

  metric_event_config: {
    groups: { CRT_event: [0] }
    streams:[slow, fast, archiving]
    metrics:{ 
      T0ResetSpread: {
	units: ns
	title: "Maximum difference in t0 reset timestamps"
      }
      T1ResetSpread: {
	units: ns
	title: "Maximum difference in t1 reset timestamps"
      }
    }
  }
  
  # TODO - remove this
  metric_fragment_config: {
     groups:{ CRT_cont_frag:[] }
     streams:[slow, fast, archiving]
     metrics:{ }
  }
}

END_PROLOG
