BEGIN_PROLOG

flashmetrics: {

    module_type: CAENV1730FlashMetricsSBND
    FlashMetricLabel: "pmtmetricsbnblight"
    metric_flashes: {
        groups: { BeamMetrics: [0] }
        hostname: "sbnd-db01.fnal.gov"
        streams: ["archiving","flash"] //["slow","fast","archiving","30s"]

        metrics: {
          flash_ts: {
            units: microseconds
            title: "Flash Peak Timestamp"
          }
          flash_pe: {
            units: pe
            title: "Flash Peak PE"
          }
        }
    }
}

END_PROLOG
