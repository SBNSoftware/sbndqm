#include "pmtflash_config.fcl"
#include "redis_connection.fcl"

process_name: SBNDPMTFlashMetrics

services: {
  RedisConnection: @local::redis_connection
  ArtdaqSharedMemoryServiceInterface: { service_provider: ArtdaqGlobalsService }
  InitMetricManager: {
    connections: {
      fast: @local::redis_metric_fast
      flash: @local::redis_metric_flash
      slow: @local::redis_metric_slow
      archive: @local::redis_metric_archive
    }
  }
} 

services.RedisConnection.host: "sbnd-db01.fnal.gov"
services.RedisConnection.passfile: "SBNDOMJun11"


source:
{
  module_type: TransferInput
  register_fragment_types: false
  # The timeout shouldn't be much smaller than the period between events, otherwise
  # there's a spew of timeout messages
  timeoutInUsecs: 10000000

  commanderPluginType: xmlrpc
  dispatcherHost: localhost
  dispatcherPort: 6021

  transfer_plugin: {
    unique_label: "FlashOnlineMonitor"
    transferPluginType: Shmem
    shm_key: 0x34913041
    max_fragment_size_words: 100000000 
    first_event_builder_rank: 0
    source_rank: 5
    destination_rank: 6
  }

  dispatcher_config: {
    unique_label: "FlashOnlineMonitor"
    path: [ out ]
    physics: {}
    outputs: {
      out: {
        module_type: TransferOutput
        transfer_plugin: {
          unique_label: "FlashOnlineMonitor"
          transferPluginType: Shmem
          shm_key: 0x34913041
          max_fragment_size_words: 100000000 
          first_event_builder_rank: 0
          destination_rank: 6
        }
      }
    }
  }
} 

outputs: {
  dumper:  {
    module_type: FileDumperOutput
    wantProductFriendlyClassName: true
    onlyIfPresent: true
   }
} 

physics:
{

 producers:{}

 filters:{}

 analyzers:{
  flashana: @local::flashmetrics
 }

 stream1:  [ ]
 ana: [ flashana ]

  out1 : [dumper]
  end_paths: [ ana ]
}

