#include "simple_channel_info.fcl"
#include "redis_connection_sbnd.fcl"

analysis_config: {
ReportingLevel:1
BoardID:3
ChannelNumber:15

EventBlock: 10
BeamBESGate: 30
OffBeamBESGate: 26
LightGate: 20
}

physics: {
  
  producers: {}

  analyzers: {

   ptbAnalysis: {

      module_type: PTBdqm

      metric_llt_trigger_rate: {
        hostname: "sbnd-db01.fnal.gov"
        groups: {
          LLT_ID: [ [0, 32] ]
        }
        streams: ["slow","fast","archiving"]
        metrics: {

          LLT_periodicity:{
            units: seconds
            title: "PTB LLT %(instance)s periodicity"
            #display_range: [ 0, 6 ]

          }
        }
      }

      metric_hlt_trigger_rate: {
        hostname: "sbnd-db01.fnal.gov"
        groups: {
          HLT_ID: [ [0, 32] ]
        }
        streams: ["slow","fast","archiving"]
        metrics: {

          HLT_periodicity:{
            units: seconds
            title: "PTB HLT %(instance)s periodicity"
            #display_range: [ 0, 6 ]

          }
        }
      }

      metric_beam_light_diff: {
        hostname: "sbnd-db01.fnal.gov"
        groups: {
          BEAM_LIGHT_DIFF: [0]
        }
        streams: ["slow","fast","archiving"]
        metrics: {

          BEAM_LIGHT:{
            units: microseconds
            title: "LIGHT - BEAM BES"
            display_range: [-10, 10]
          }

          OFFBEAM_LIGHT:{
            units: microseconds
            title: "LIGHT - OFFBEAM BES"
            display_range: [-10, 10]

          }
        }
      }

      metric_beam_crt_diff: {
        hostname: "sbnd-db01.fnal.gov"
        groups: {
          BEAM_CRT_DIFF: [0]
        }
        streams: ["slow","fast","archiving"]
        metrics: {

          BEAM_HLT_T1RESET:{
            units: microseconds
            title: "BEAM HLT - BEAM T1 RESET"
          }

          OFFBEAM_HLT_T1RESET:{
            units: microseconds
            title: "OFFBEAM HLT - OFFBEAM T1 RESET"
          }

          NUMBER_OFFBEAM_T1RESET:{}

          NUMBER_BEAM_T1RESET:{}

          NUMBER_OFFBEAM_HLT:{}

          NUMBER_BEAM_HLT:{}

        }
      }

      metric_ptb_tdc_diff: {
        hostname: "sbnd-db01.fnal.gov"
        groups: {
          PTB_TDC_DIFF: [0]
        }
        streams: ["slow","fast","archiving"]
        metrics: {
          TDC_HLT_FLASH:{
            units: microseconds
            title: "|PTB - TDC| flash trigger timestamps"
          }

          TDC_HLT_EVENT:{
            units: microseconds
            title: "|PTB - TDC| event trigger timestamps"
          }

          TDC_HLT_T1:{
            units: microseconds
            title: "|PTB - TDC| CRT t1 reset timestamps"
          }

          TDC_LLT_BES:{
            units: microseconds
            title: "|PTB - TDC| BES timestamps"
          }

          NUMBER_TDC_T1:{}

          NUMBER_TDC_BES:{}

          NUMBER_TDC_FLASH:{}

          NUMBER_TDC_EVENT:{}

          NUMBER_PTB_T1:{}

          NUMBER_PTB_BES:{}

          NUMBER_PTB_FLASH:{}

          NUMBER_PTB_EVENT:{}
        }
      }      
    }
  }
  
  ana: [ ptbAnalysis ]
  end_paths: [ ana ]

}


services: {

  ##TFileService: { fileName: "MSUMtest.root"}

  RedisConnection: @local::redis_connection

  InitMetricManager: {
    connections: {
      fast: @local::redis_metric_fast
      slow: @local::redis_metric_slow
      archive: @local::redis_metric_archive
    }
  }

} 

services.RedisConnection.host: "sbnd-db01.fnal.gov"
services.RedisConnection.passfile: "/home/nfs/sbnd/redis_passfile"


services.InitMetricManager.connections.fast.send_zeros: false
services.InitMetricManager.connections.slow.send_zeros: false
services.InitMetricManager.connections.archiving.send_zeros: false


source:
{
  module_type: RootInput
  
  fileNames: ["/daq/scratch/Trigger_Online/data_evb03_run9800_1_20231117T171942.root", 
              "/daq/scratch/Trigger_Online/data_evb03_run9800_2_20231117T171946.root",
              "/daq/scratch/Trigger_Online/data_evb03_run9800_3_20231117T171950.root", 
              "/daq/scratch/Trigger_Online/data_evb03_run9800_4_20231117T171954.root", 
              "/daq/scratch/Trigger_Online/data_evb03_run9800_5_20231117T171956.root", 
              "/daq/scratch/Trigger_Online/data_evb03_run9800_6_20231117T172000.root", 
              "/daq/scratch/Trigger_Online/data_evb03_run9800_7_20231117T172004.root"]
}

 
process_name: SBNDPTBANALYSIS
