#include "simple_channel_info.fcl"
#include "redis_connection_sbnd.fcl"
#include "TPCDQMChannelMapService.fcl"
#include "SBNDDQMTPCDecoderDefaults.fcl"
#include "services_sbnd.fcl"
#include "simulationservices_sbnd.fcl"
#include "opticaldetectormodules.fcl"
#include "pmt_stream_config_SBND.fcl" 
#include "config_spectdc_dqm.fcl"
#include "config_ptb_dqm.fcl"
#include "config_pmt_dqm.fcl"
#include "config_crt_dqm.fcl"
#include "config_tpc_dqm.fcl"
#include "pmtflash_config.fcl"


services:
{
  RedisConnection: @local::redis_connection
  ArtdaqSharedMemoryServiceInterface: { service_provider: ArtdaqGlobalsService }
  TPCDQMChannelMapService: @local::SBNDTPCDQMChannelMapServiceDefaults
  #AuxDetExptGeoHelperInterface: { service_provider: "sbndcode/CRT/CRTGeometryHelper" }
  #ExptGeoHelperInterface:    @local::sbnd_geometry_helper
  #Geometry:                  @local::sbnd_geo
  #GeometryConfigurationWriter:    {}
  @table::sbnd_geometry_services

  #For CRT
  InitMetricManager: {
    connections: {
      fast: @local::redis_metric_fast
      slow: @local::redis_metric_slow
      archive: @local::redis_metric_archive
    }
  }

}

services.RedisConnection.host: "sbnd-db03.fnal.gov"
services.RedisConnection.passfile: "/home/nfs/sbnd/redis_passfile"
services.TPCDQMChannelMapService: @local::SBNDTPCDQMChannelMapServiceDefaults


source:
{
  module_type: RootInput
  maxEvents:   9999999  
}

outputs: {
  dumper: {
    module_type: FileDumperOutput
    wantProductFriendlyClassName: true
    onlyIfPresent: true
  }
}

physics:
{
  filters: {
    f1: {
        module_type: EventIDFilter
        errorOnFailureToPut: true  # default
        idsToMatch: [
            "*:*:0"
        ]
    }
    crtfilter: {
        module_type: EventIDFilter
        errorOnFailureToPut: true  # default
        idsToMatch: [
            "*:*:0"
        ]
    }
    prescale1:{
      module_type: "Prescaler"
      prescaleFactor: 1
      prescaleOffset: 0
    }
    prescale2:{
      module_type: "Prescaler"
      prescaleFactor: 2
      prescaleOffset: 0
    }
    prescale3:{
      module_type: "Prescaler"
      prescaleFactor: 3
      prescaleOffset: 0
    }
    prescale5:{
      module_type: "Prescaler"
      prescaleFactor: 5
      prescaleOffset: 0
    }
    prescale10:{
      module_type: "Prescaler"
      prescaleFactor: 10
      prescaleOffset: 0
    }
    prescale20:{
      module_type: "Prescaler"
      prescaleFactor: 20
      prescaleOffset: 0
    }
    prescale50:{
      module_type: "Prescaler"
      prescaleFactor: 50
      prescaleOffset: 0
    }
    prescale100:{
      module_type: "Prescaler"
      prescaleFactor: 100
      prescaleOffset: 0
    }
  }


  // now also have something produce the digits and headers
  producers:
  {
    daq: {
      module_type: SBNDDQMTPCDecoder
      # for debugging -- time (in s) to wait in between analyzing events
      wait_time: -1
      # make the header
      produce_header: true
      baseline_calc: true
      # parameters for timestamps
      timesize: 2519
      # produce timestamps in units of mus
      frame_to_dt: 0.5
      # parameters for header index
      min_slot_no: 3
      channel_per_slot: 64
    }
    daqPMT: {
      module_type: DaqDecoderSBNDPMT
      FragmentLabels: [ "daq:CAENV1730", "daq:ContainerCAENV1730" ]
    }
    daqSPECTDC: {
      module_type:           "SPECTDCDecoder"
      SPECTDCInstanceLabels: [ "TDCTIMESTAMP", "ContainerTDCTIMESTAMP" ]
    }
  }

  analyzers:
  {
    # Trigger
    ptbAnalysis: @local::streamPTB

    # Timing
    dqmSPECTDC: @local::streamSPECTDC

    # PMT
    MetaPMT: {
      module_type: ReportMetadata
      RedisKey: eventmetaPMT
      SelectEvents: [pmt_only]
    }
    pmtAnalysis: @local::streamPMT

    # CRT
    MetaCRT: {
      module_type: ReportMetadata
      RedisKey: eventmetaCRT
      SelectEvents: [crt_only]
    }   

    crtana: @local::streamCRT
    
    # TPC
    Meta: {
      module_type: ReportMetadata
      RedisKey: eventmeta
    }

    OnlineEvdSBND: {
      module_type: OnlineEvdSBND
      raw_digit_producers: [daq]
      verbose: false
      timing: false
    }

    OnlineAnalysisRawData: @local::streamTPCraw
    OnlineAnalysis: @local::streamTPC

    # Flash
    MetaFlash: {
      module_type: ReportMetadata
      RedisKey: eventmetaFlash
      SelectEvents: [flash_only]
    }   

    flashana: @local::flashmetrics

  }
}

physics.analyzers.ptbAnalysis.SelectEvents: [trigger_only]

physics.analyzers.dqmSPECTDC.SelectEvents: [timing_only]
physics.analyzers.dqmSPECTDC.DAQTimestampLabel: "daqSPECTDC"

physics.analyzers.pmtAnalysis.SelectEvents: [pmt_only]
physics.analyzers.pmtAnalysis.OpDetWaveformLabel: "daqPMT"

physics.analyzers.crtAnalysis.SelectEvents: [crt_only]

physics.analyzers.flashAnalysis.SelectEvents: [flash_only]


physics.crt_only: [ prescale1 ]
physics.pmt_only: [ daqPMT ]
physics.tpc_only: [ daq ] 
physics.timing_only: [ daqSPECTDC ]
physics.trigger_only: [ prescale1 ]
physics.flash_only: [ prescale1 ]

physics.crt_path: [ crt_only ]
physics.pmt_path: [ pmt_only ]
physics.tpc_path: [ tpc_only ]
physics.timing_path: [ timing_only ]
physics.trigger_path: [ trigger_only ]
physics.flash_path: [ flash_only]

physics.trigger_paths: [@sequence::physics.tpc_path, @sequence::physics.pmt_path , @sequence::physics.crt_path, @sequence::physics.timing_path, @sequence::physics.trigger_path, @sequence::physics.flash_path ]

physics.atpc:         [ Meta, OnlineAnalysis, OnlineAnalysisRawData] #, OnlineEvdSBND ]
physics.apmt:         [ MetaPMT, pmtAnalysis ]
physics.acrt:         [ MetaCRT, crtana ]
physics.atiming:      [ dqmSPECTDC ]
physics.atrigger:     [ ptbAnalysis ]
physics.aflash:     [ flashana ]

physics.a: [@sequence::physics.atpc, @sequence::physics.apmt, @sequence::physics.acrt, @sequence::physics.atiming, @sequence::physics.atrigger, @sequence::physics.aflash ]

physics.decoded_stream: [ decodedout ]
physics.end_paths: [ a ]
physics.out1 : [dumper]


process_name: DQMANALYSIS

